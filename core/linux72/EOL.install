eol() {
  echo ">>> NOTE, 7.2.15 is the last maintenance release of the 7.2 kernel series."
  echo "    This kernel is now marked 'End Of Life' (EOL)."
  echo "    "
  echo "    It is recommended to switch to the newer linux73 series:"
  echo "    'sudo mhwd-kernel -i linux73'"
  echo "    "
}

post_upgrade() {
  eol
}

post_install() {
  eol
}

