#!/bin/bash

# Skip if running in a build chroot/container
if [[ -f /.manjaro-chroot ]] || [[ -f /.manjaro-tools ]]; then
    echo ":: [chroot detected] Skipping pacman-mirrors configuration"
    exit 0
else
  pacman-mirrors --no-mirrorlist
  echo "hint: use \`pacman-mirrors\` to generate and update your pacman mirrorlist."
fi
