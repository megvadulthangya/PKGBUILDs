#!/bin/bash

# Detect chroot/container (any type) and skip pacman-mirrors configuration
if [[ -f /.manjaro-chroot ]] || [[ -f /.manjaro-tools ]]; then
    echo ":: [chroot / container detected] Skipping pacman-mirrors configuration"
    exit 0
else
    pacman-mirrors --no-mirrorlist
    echo "Hint: Use \`pacman-mirrors\` to generate and update your pacman mirrorlist."
fi
