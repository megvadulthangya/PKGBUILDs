pkgbase=boxit
#pkgname=(boxit-arm boxit-arm-server)
pkgname=${pkgbase}-arm
pkgver=2.1.3
pkgrel=18
arch=('x86_64' 'aarch64')
url="https://gitlab.manjaro.org/tools/maintenance-tools/boxit"
license=('GPL-3.0-or-later')
depends=(
  'icu'
  'qt5-base'
  'readline'
)
makedepends=('git')
_commit=ba614c259a13a473316b9396e8d5f6008b783b14  # branch/arm
source=("git+https://gitlab.manjaro.org/tools/maintenance-tools/boxit.git#commit=${_commit}")
sha256sums=('SKIP')

build() {
  cd "$srcdir/$pkgbase/$pkgbase/src"
  qmake-qt5

  # Build fix
  make sub-DBus
  cp DBus/libDBus.a libDBus.a

  make all

#  if [ -e "$srcdir/core-$pkgbase" ]; then
#	   cd "$srcdir/core-$pkgbase/$pkgbase-server/src"
#  else
#     cd "$srcdir/$pkgbase/$pkgbase-server/src"
#  fi

#  qmake-qt5 -spec linux-clang

#  make all
}

#package_boxit-arm() {
package() {
  pkgdesc="Manjaro Linux repository management system client"
  depends=('qt5-base' 'readline' 'icu')
  if [ -e "$srcdir/core-$pkgbase" ]; then
     cd "$srcdir/core-$pkgbase/$pkgbase/src"
  else
     cd "$srcdir/$pkgbase/$pkgbase/src"
  fi
  make INSTALL_ROOT="${pkgdir}" install
}

