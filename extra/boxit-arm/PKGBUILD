pkgname=(
  'boxit-arm'
  # 'boxit-arm-server'
)
pkgbase=boxit
pkgver=2.1.3
pkgrel=19
arch=('x86_64' 'aarch64')
url="https://code.manjaro.org/tools/boxit"
license=('GPL-3.0-or-later')
depends=(
  'icu'
  'qt5-base'
  'readline'
)
makedepends=('git')
_commit=ba614c259a13a473316b9396e8d5f6008b783b14  # branch/arm
source=("git+https://code.manjaro.org/tools/boxit.git#commit=${_commit}")
sha256sums=('e0e575884b4cbc5ad82a4bfe0e8b065ee55a8b758701b596d7e20e835ceab70d')

build() {
  cd "$pkgbase/$pkgbase/src"
  qmake-qt5 \
    PREFIX=/usr \
    QMAKE_CFLAGS="${CFLAGS}" \
    QMAKE_CXXFLAGS="${CXXFLAGS}" \
    QMAKE_LFLAGS="${LDFLAGS}"

  # Build fix
  make sub-DBus
  cp DBus/libDBus.a libDBus.a

  make all

#  if [ -e "$srcdir/core-$pkgbase" ]; then
#	   cd "$srcdir/core-$pkgbase/$pkgbase-server/src"
#  else
#     cd "$srcdir/$pkgbase/$pkgbase-server/src"
#  fi

  # qmake-qt5 \
  #   -spec linux-clang
  #   PREFIX=/usr \
  #   QMAKE_CFLAGS="${CFLAGS}" \
  #   QMAKE_CXXFLAGS="${CXXFLAGS}" \
  #   QMAKE_LFLAGS="${LDFLAGS}"
  #   make all
}

package_boxit-arm() {
  pkgdesc="Manjaro Linux repository management system client"
  depends=(
    'icu'
    'qt5-base'
    'readline'
  )

  if [ -e "$srcdir/core-$pkgbase" ]; then
     cd "$srcdir/core-$pkgbase/$pkgbase/src"
  else
     cd "$srcdir/$pkgbase/$pkgbase/src"
  fi
  make INSTALL_ROOT="${pkgdir}" install
}

package_boxit-arm-server() {
  pkgdesc="Manjaro Linux repository management system server"
  depends=(
    'boxit-server'
    'icu'
    'qt5-base'
    'readline'
  )

  if [ -e "$srcdir/core-$pkgbase" ]; then
    cd "$srcdir/core-$pkgbase/$pkgbase-server/src"
  else
    cd "$srcdir/$pkgbase/$pkgbase-server/src"
  fi

  # TODO - convert to systemd-scripts
  # mkdir -p ${pkgdir}/etc/init.d
  # mkdir -p ${pkgdir}/usr/bin
  # mkdir -p ${pkgdir}/etc/boxit

  make INSTALL_ROOT="${pkgdir}" install

  # clean-up conflicting files
  rm "${pkgdir}"/usr/bin/repo*
  rm "${pkgdir}"/usr/bin/pkgdelta
}
