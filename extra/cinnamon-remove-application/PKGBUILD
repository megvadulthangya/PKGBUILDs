# Maintainer: Mark Wagie <mark at manjaro dot org>
# Contributor: Giulio Girardi <giulio at rapgenic.it>
# Contributor: stoffel <https://forum.manjaro.org/u/stoffel>

# Based on cinnamon-remove-application from mint-common package:
# https://github.com/linuxmint/mintcommon

pkgname=cinnamon-remove-application
pkgver=1.0.0
pkgrel=1
epoch=1
pkgdesc="Enables the uninstall option in the Cinnamon application context menu"
arch=('any')
url="https://github.com/username227/cinnamon-remove-application"
license=('GPL-2.0-or-later')
depends=(
  'cinnamon'
  'glib2'
  'gtk3'
  'polkit'
  'python'
  'python-gobject'
)
optdepends=('mint-translations: i18n')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/$pkgver.tar.gz")
sha256sums=('137e6a54e2bbe630f227abea89a0f44c293995cac88886eec6caedc95006995c')

prepare() {
  cd "$pkgname-$pkgver"

  # Use standard locale directory
  sed -i 's|/usr/share/linuxmint/locale|/usr/share/locale|g' "usr/bin/$pkgname"
}

check() {
  cd "$pkgname-$pkgver"
  python -m venv --clear --without-pip --system-site-packages test-env
  test-env/bin/python -I -m unittest discover -s tests -v
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 "usr/bin/$pkgname" -t "$pkgdir/usr/bin/"
  install -Dm644 "usr/lib/$pkgname"/*.py -t "$pkgdir/usr/lib/$pkgname/"
}
