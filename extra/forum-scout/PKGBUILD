# Maintainer: Mark Wagie <mark at manjaro dot org>

pkgname=forum-scout
pkgver=0.6.6
pkgrel=2
pkgdesc="Arch focused forum search tool"
arch=('any')
url="https://codeberg.org/linux-bird/forum-scout"
license=('MIT')
depends=(
  'gtk4'
  'python-gobject'
  'python-requests'
)
makdepends=('git')
source=("git+https://codeberg.org/linux-bird/forum-scout.git#tag=v$pkgver")
sha256sums=('28e5f89ef0c1ea4af85b18b0e4034005abbb063d8c2ff3f8804af4e717bf73f4')

prepare() {
  cd "$pkgname"
  sed -i "s/__VERSION__/$pkgver/" "$pkgname.py"

  # Correct StartupWMClass & remove unrelated category
  desktop-file-edit --set-key=StartupWMClass --set-value "org.musqz.$pkgname" \
    --remove-category=Network \
    "$pkgname.desktop"
}

check() {
  cd "$pkgname"
  desktop-file-validate "$pkgname.desktop"
}

package() {
  cd "$pkgname"
  install -Dm755 "$pkgname.py" "$pkgdir/usr/bin/$pkgname"
  install -Dm644 "$pkgname.desktop" -t "$pkgdir/usr/share/applications/"
  install -Dm644 forums.conf -t "$pkgdir/usr/share/$pkgname/"
  install -Dm644 translations/*.json -t "$pkgdir/usr/share/$pkgname/translations/"
  install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"
}
