pkgname=gnome-shell-extension-arc-menu
pkgver=70.0
pkgrel=1
pkgdesc="Application menu extension for GNOME Shell"
arch=('any')
url="https://gitlab.com/arcmenu/ArcMenu"
license=('GPL-2.0-or-later')
depends=(
  'gnome-menus'
  'gnome-shell'
)
makedepends=('git')
conflicts=('gnome-shell-extension-arcmenu')
replaces=('gnome-shell-extension-arcmenu')
source=("git+https://gitlab.com/arcmenu/ArcMenu.git#tag=v$pkgver")
sha256sums=('65eab04eb4ca08ab748103ac0ec57cb497a574cdf829e5b6c9375df9f8f56163')

prepare() {
  cd ArcMenu
}

build() {
  cd ArcMenu
  make
}

package() {
  cd ArcMenu
  make VERSION="$pkgver" DESTDIR="$pkgdir" install
}
