arch=('any')
url="https://github.com/chrispouliot/cardwire-toggle"
license=('GPL-2.0-or-later')
depends=(
  'cardwire'
  'gnome-shell'
)
# makedepends=('jq')

# Source code does not contain changes between v1.3 & v1.4
# source=("cardwire-toggle-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
source=("cardwire-toggle-$pkgver-shell-extension.zip::$url/releases/download/v$pkgver/${_uuid}.shell-extension.zip")
noextract=('*.shell-extension.zip')
sha256sums=('b58f3d2937995474ec382c8bb91d1fa2fe729927374d57d3d74191fc1c5dc53b')

