pkgname=gnome-shell-extension-gamemode
pkgver=21.0
pkgrel=1
pkgdesc="GameMode Status Indicator for GNOME Shell"
arch=('any')
url="https://github.com/Trsnaqe/gamemode-shell-extension"
license=('LGPL-2.1-or-later')
depends=(
  'gamemode'
  'gnome-shell'
)
makedepends=(
  'git'
  'meson'
)
source=("git+https://github.com/Trsnaqe/gamemode-shell-extension.git#tag=V$pkgver")
sha256sums=('aaa602b596717e10c5fe4dcca0506d07e1b1f33be95ff94e127c42f4302470e7')

build() {
  arch-meson gamemode-shell-extension build
  meson compile -C build
}

package() {
  meson install -C build --no-rebuild --destdir "$pkgdir"
}
