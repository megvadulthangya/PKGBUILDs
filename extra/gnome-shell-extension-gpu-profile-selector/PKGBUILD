# Maintainer: Mark Wagie <mark at manjaro dot org>

pkgname=gnome-shell-extension-gpu-profile-selector
pkgver=26
pkgrel=2
epoch=1
pkgdesc="Provides a simple way to switch between GPU profiles on NVIDIA Optimus systems"
arch=('any')
url="https://github.com/LorenzoMorelli/GPU_profile_selector"
license=('GPL-3.0-or-later')
depends=(
  'bash'
  'envycontrol'
  'gnome-shell'
  'polkit'
)
makedepends=(
  'git'
  'jq'
)
source=("git+https://github.com/LorenzoMorelli/GPU_profile_selector.git#tag=v$pkgver"
        'gnome51.patch')
sha256sums=('3fec27e0c5c1aa08a72e70e9dbe1cc9cf34c3a8ada762870363773303aa05e67'
            '6a880c9f950c9f8955540aa105784d171b2f0c4b44f76667e18da3dc4f7544e3')

prepare() {
  cd GPU_profile_selector

  # GNOME 51 support
  patch -Np1 -i ../gnome51.patch
}

build() {
  cd GPU_profile_selector
  gnome-extensions pack \
     --extra-source=img/ \
     --extra-source=lib/ \
     --extra-source=ui/ \
     --force
}

package() {
  cd GPU_profile_selector
  _uuid=$(jq -r .uuid metadata.json)

  install -d "$pkgdir/usr/share/gnome-shell/extensions/${_uuid}"
  bsdtar -xvf "${_uuid}.shell-extension.zip" -C \
    "$pkgdir/usr/share/gnome-shell/extensions/${_uuid}/" --no-same-owner

  install -Dvm644 schemas/*.gschema.xml -t "$pkgdir/usr/share/glib-2.0/schemas/"
  rm -rfv "$pkgdir/usr/share/gnome-shell/extensions/${_uuid}/schemas"
}
