# Maintainer: Mark Wagie <mark at manjaro dot org>

pkgname=gnome-shell-extension-gsconnect
pkgver=74
pkgrel=1
pkgdesc="KDE Connect implementation with GNOME Shell integration"
arch=('any')
url="https://github.com/GSConnect/gnome-shell-extension-gsconnect"
license=('GPL-2.0-or-later OR MPL-2.0')
depends=('gnome-shell')
makedepends=(
  'git'
  'meson'
)
checkdepends=(
  'appstream'
  'desktop-file-utils'
)
optdepends=(
  'evolution-data-server: Use contacts from GNOME Online Accounts or Evolution'
  'gsound: Sound effects'
  'nautilus-python: Share files from Nautilus'
  'nemo-python: Share files from Nemo'
)
source=("git+https://github.com/GSConnect/gnome-shell-extension-gsconnect#tag=v$pkgver")
sha256sums=('b9e48c2578ca0e63cc88be30d77dcb6d587112df4da8f03645ef5d28705dd6a7')

build() {
  local meson_options=(
    -D firewalld=true
    -D nemo=true
    -D installed_tests=false
  )
  arch-meson "$pkgname" build "${meson_options[@]}"
  meson compile -C build
}

check() {
  meson test -C build --no-rebuild --suite gsconnect:data --print-errorlogs
}

package() {
  meson install -C build --no-rebuild --destdir "$pkgdir"
}
