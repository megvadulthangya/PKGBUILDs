# Maintainer: Mark Wagie <mark at manjaro dot org>
# Contributor: sachesi <xsachesi@pm.me>

pkgname=gnome-vram-booster
pkgver=0.7.3
pkgrel=2
pkgdesc="Dynamic VRAM prioritization for GNOME"
arch=('x86_64')
url="https://github.com/sachesi/gnome-vram-booster"
license=('GPL-3.0-or-later')
depends=(
  'dmemcg-booster'
  'glibc'
  'libgcc'
  'systemd-libs'
)
makedepends=(
  'glib2'
  'gnome-shell'
  'jq'
  'rust'
)
install="$pkgname.install"
optdepends=('gnome-shell: The extension that reports the focused window')
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver/$pkgname-$pkgver.tar.gz")
sha256sums=('c343db59eb3c3aa8b2e73168134ad2503bd8c5c50ede1358093d0c5bf2e35ca8')

prepare() {
  cd "$pkgname-$pkgver"
  cargo fetch --manifest-path daemon/Cargo.toml --locked --target host-tuple
}

build() {
  cd "$pkgname-$pkgver"

  pushd daemon
  export CARGO_TARGET_DIR=target
  export CARGO_PROFILE_RELEASE_LTO=true
  export CARGO_PROFILE_RELEASE_CODEGEN_UNITS=1
  cargo build --frozen --release
  popd

  gnome-extensions pack extension/ --force
}

check() {
  cd "$pkgname-$pkgver/daemon"
  cargo test --frozen
}

package() {
  cd "$pkgname-$pkgver"
  _uuid=$(jq -r .uuid extension/metadata.json)

  install -Dm755 daemon/target/release/{"$pkgname","${pkgname}ctl"} -t \
    "$pkgdir/usr/bin/"
  install -Dm644 "packaging/usr/lib/systemd/system/$pkgname.service" -t \
    "$pkgdir/usr/lib/systemd/system"
  install -Dm644 packaging/usr/share/dbus-1/system.d/org.gnome.VramBooster.conf -t \
    "$pkgdir/usr/share/dbus-1/system.d"
  install -Dm644 README.md docs/usage.md -t "$pkgdir/usr/share/doc/$pkgname/"

  install -d "$pkgdir/usr/share/gnome-shell/extensions/${_uuid}"
  bsdtar -xvf "${_uuid}.shell-extension.zip" -C \
    "$pkgdir/usr/share/gnome-shell/extensions/${_uuid}/" --no-same-owner

  # Schema not detected in system location
  glib-compile-schemas "$pkgdir/usr/share/gnome-shell/extensions/${_uuid}/schemas/"
}
