post_install() {

cat << _EOF

==> Setting default GRUB_THEME to Manjaro..."
==> GRUB_THEME="/usr/share/grub/themes/manjaro/theme.txt"

_EOF

  sed -i -e 's,.*GRUB_THEME=.*,GRUB_THEME="/usr/share/grub/themes/manjaro/theme.txt",' /etc/default/grub
  grub-mkconfig -o /boot/grub/grub.cfg
}

post_remove() {

cat << _EOF

==> Setting default GRUB_THEME to Starfield..."
==> GRUB_THEME="/usr/share/grub/themes/starfield/theme.txt"
==> Edit your /etc/default/grub to specify a different theme

_EOF

  sed -i -e 's,.*GRUB_THEME=.*,GRUB_THEME="/usr/share/grub/themes/starfield/theme.txt",' /etc/default/grub
  grub-mkconfig -o /boot/grub/grub.cfg
}
