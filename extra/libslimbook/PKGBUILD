# Slimbook OBS
# https://build.opensuse.org/package/show/home:Slimbook/libslimbook

pkgname=libslimbook
pkgver=1.27.1
pkgrel=1
pkgdesc="Core functionality for Slimbook apps"
arch=('x86_64')
url="https://github.com/Slimbook-Team/libslimbook"
license=('LGPL-3.0-or-later')
depends=(
  'bash'
  'libgcc'
  'libstdc++'
  'lsb-release'
)
makedepends=('meson')
provides=('libslimbook.so=1')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/$pkgver.tar.gz")
#source=("https://launchpad.net/~slimbook/+archive/ubuntu/slimbook/+sourcefiles/$pkgname/$pkgver/${pkgname}_${pkgver}.tar.xz")
#noextract=("${pkgname}_${pkgver}.tar.xz")
sha256sums=('e5b20d60bb0ddd7b1b5c51f4ab0b105261e1ae33606b2ff59e0bde4dffde13a6')

prepare() {
#  mkdir -p "$pkgname-$pkgver"
#  bsdtar xf "${pkgname}_${pkgver}.tar.xz" --strip-components 1 -C "$pkgname-$pkgver"

  cd "$pkgname-$pkgver"
  find . -type f -exec sed -i 's/libexec/lib/g' {} \;
}

build() {
  arch-meson "$pkgname-$pkgver" build
  meson compile -C build
}

package() {
  meson install -C build --no-rebuild --destdir "$pkgdir"
}
