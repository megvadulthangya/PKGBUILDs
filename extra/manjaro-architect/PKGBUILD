# Maintainer:
# Contributor: Chrysostomus <forum.manjaro.org/u/Chrysostomus>
# Contributor: Bernhard Landauer <bernhard@manjaro.org>

pkgname=(
  'manjaro-architect'
  'manjaro-architect-launcher'
)
pkgbase=manjaro-architect
pkgver=0.9.39
pkgrel=2
pkgdesc="Manjaro CLI net-installer"
arch=('any')
url="https://code.manjaro.org/applications/manjaro-architect"
license=('GPL-2.0-or-later')
depends=(
  'bash'
  'dialog'
  'fzf'
  'git'
  'manjaro-tools-base'
)
makedepends=('git')
optdepends=(
  'maia-console'
  'terminus-font'
)
source=("git+https://code.manjaro.org/applications/manjaro-architect.git#tag=$pkgver")
sha256sums=('313e5788d46a9457bb31e7049ef1e26b9f585b561146fc90ef19d5c90f528c07')

prepare() {
  cd "$pkgbase"
  sed -i "s/Version .*/Version = $pkgver/" Makefile
}

build() {
  cd "$pkgbase"
  make
}

package_manjaro-architect() {
  depends+=(
    'btrfs-progs'
    'f2fs-tools'
    'gptfdisk'
    'manjaro-architect-launcher'
    'mhwd'
    'nilfs-utils'
    'pacman-mirrorlist'
    'parted'
    'profile-validate'
  )

  cd "$pkgbase"
  make DESTDIR="$pkgdir" install
}

package_manjaro-architect-launcher() {
  pkgdesc="Manjaro Architect launcher"

  cd "$pkgbase"
  install -Dm755 bin/setup "$pkgdir"/usr/bin/setup
}
