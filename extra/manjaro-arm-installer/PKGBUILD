pkgname=manjaro-arm-installer
pkgver=1.5.4
pkgrel=2
pkgdesc="Scripts to install Manjaro ARM directly to SD/eMMC cards"
arch=('x86_64' 'aarch64')
url="https://code.manjaro.org/applications/manjaro-arm-installer"
license=('GPL-3.0-or-later')
depends_x86_64=('dialog'
  'gawk'
  'git'
  'libarchive'
  'qemu-user-static-binfmt'
  'parted'
  'wget'
  'openssl'
  'dosfstools'
  'polkit'
)
depends_aarch64=(
  'dialog'
  'gawk'
  'git'
  'libarchive'
  'parted'
  'wget'
  'openssl'
  'dosfstools'
  'polkit'
)
makedepends=('git')
optdepends=(
  'btrfs-progs: btrfs filesystem utilities'
  'f2fs-tools: f2fs filesystem utilities'
  'cryptsetup: encryption support'
)
#optdepends_x86_64+=(
#  'grub-efi-arm64: for generic-efi support (only needed when script is run from other architectures than aarch64)' # AUR
#)
install="$pkgname.install"
source=("git+https://code.manjaro.org/applications/manjaro-arm-installer.git#tag=$pkgver")
sha256sums=('59351f1d40dd2bc3dfb43e201bcfc9fdf09c18f46f33f28a4a9b8daae178270c')

package() {
  cd "$pkgname"
  install -Dm755 "$pkgname" "$pkgdir/usr/bin/$pkgname"
}
