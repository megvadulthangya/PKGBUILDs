pkgname=manjaro-downgrade
pkgver=3.0
pkgrel=1
pkgdesc="Bash script for downgrading one or more packages to a version in your cache or the M.L.A."
arch=('any')
url="https://codeberg.org/Ste74/manjaro-downgrade/$pkgname"
license=('GPL')
backup=(etc/xdg/manjaro-downgrade/manjaro-downgrade.conf)
source=("https://codeberg.org/Ste74/$pkgname/archive/v$pkgver.tar.gz")	
depends=('pacman-contrib' 'fzf') # pacsort
optdepends=('sudo: for installation via sudo')

package() {
  cd $pkgname || exit 1

  make DESTDIR="$pkgdir" PREFIX=/usr install
}

sha256sums=('28bf8cd2b32453eaa4e4f164b64ae74a90778545edbd228635339d5260ffff60')
