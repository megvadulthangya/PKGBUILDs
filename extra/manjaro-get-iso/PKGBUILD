# Maintainer: linux-aarhus <fh at manjaro . org>

pkgname='manjaro-get-iso'
pkgver=0.21
pkgrel=2
pkgdesc='A tool to download Manjaro ISO'
arch=('any')
url='https://code.manjaro.org/applications/manjaro-get-iso'
license=('MIT')
depends=(
  '7zip'
  'python-requests'
)
makedepends=('git')
source=("git+https://code.manjaro.org/applications/manjaro-get-iso.git#tag=v${pkgver}")
sha256sums=('ec27410ed780ae6e155534e6301049b9a1af453ae38fbab2e22d63b5a439f0b5')

package() {
    cd "${pkgname}"
    install -Dm755 get-iso -t "$pkgdir/usr/bin"
    install -Dm644 LICENSE -t "${pkgdir}/usr/share/licenses/${pkgname}"
}
