# Maintainer: Stefano Capitani <stefanoatmanjarodotorg>

pkgname=manjaro-iso-downloader
pkgver=0.3.6
pkgrel=3
pkgdesc="Download and verify Manjaro ISOs"
arch=('any')
url="https://code.manjaro.org/applications/manjaro-iso-downloader"
license=('GPL-3.0-or-later')
depends=(
  'aria2'
  'curl'
  'manjaro-icons'
  'wget'
  'yad'
  'zenity'
)
makedepends=('git')
conflicts=('manjaro-downloader-images')
replaces=('manjaro-downloader-images')
source=("git+https://code.manjaro.org/applications/manjaro-iso-downloader.git#tag=$pkgver")
sha256sums=('f738dce480b4d14ca8f98d7848891be46fe04d6d0211ca622bafb0bbe3e6ce27')

package() {
	cd "$pkgname"
	install -Dm755 "$pkgname.sh" "$pkgdir/usr/bin/$pkgname"
	install -Dm644 "$pkgname.desktop" -t "$pkgdir/usr/share/applications/"
	cp -Rf icons "$pkgdir/usr/share"
}
