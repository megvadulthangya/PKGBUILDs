# Maintainer: Stefano Capitani <stefano@manjaro.org>

pkgname=manjaro-rescue
pkgver=3.1.0
pkgrel=2
pkgdesc="Professional system restore utility for Manjaro Linux"
arch=('any')
url="https://codeberg.org/Ste74/manjaro-rescue"
license=('GPL-3.0-or-later')
depends=(
  'grub'
  'gtk4'
  'libadwaita'
  'manjaro-tools-base-git'
  'os-prober'
  'polkit'
  'python'
  'python-gobject'
  'bmenu'
  'manjaro-log-helper'
  'timeshift'
  'mc'
)
makedepends=('git')
source=("${pkgname}-${pkgver}.tar.gz::$url/archive/$pkgver.tar.gz")
noextract=("${pkgname}-${pkgver}.tar.gz")
sha256sums=('d7be0c00a00af94d5efccb39bce41c64101be5b7c1b9ff2653d14070a5c30f23')

prepare() {
  mkdir -p "${pkgname}-${pkgver}"
  bsdtar xf "${pkgname}-${pkgver}.tar.gz" --strip-components 1 -C "${pkgname}-${pkgver}"
}

package() {
  cd "${pkgname}-${pkgver}"

  install -d "${pkgdir}/usr/bin"
  install -d "${pkgdir}/usr/lib/${pkgname}"
  install -d "${pkgdir}/usr/share/applications"
  install -d "${pkgdir}/usr/share/icons/hicolor/scalable/apps"

  cp -r backend utils locale "${pkgdir}/usr/lib/${pkgname}/"
  [ -d icons ] && cp -a icons "${pkgdir}/usr/lib/${pkgname}/"
  install -m755 main.py "${pkgdir}/usr/lib/${pkgname}/"
  install -m644 window.ui "${pkgdir}/usr/lib/${pkgname}/"

  ln -s "/usr/lib/${pkgname}/main.py" "${pkgdir}/usr/bin/${pkgname}"
  ln -s "/usr/lib/${pkgname}/icons/hicolor/scalable/apps/${pkgname}.svg" \
    "${pkgdir}/usr/share/icons/hicolor/scalable/apps/${pkgname}.svg"

  install -m644 "${pkgname}.desktop" "${pkgdir}/usr/share/applications/"

  python -m compileall -d / "$pkgdir/usr/lib/$pkgname"
  python -O -m compileall -d / "$pkgdir/usr/lib/$pkgname"
}
