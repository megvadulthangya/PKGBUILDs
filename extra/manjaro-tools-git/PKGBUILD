# Contributor: Bernhard Landauer <bernhard@manjaro.org>
# Contributor: Frede Hundewadt <fhatmanjarorg>

pkgname=(
  'manjaro-tools-base-git'
  'manjaro-tools-pkg-git'
  'manjaro-tools-iso-git'
  'manjaro-tools-yaml-git'
)
pkgbase=manjaro-tools-git
pkgver=0.15.13.r82.gdc6ba13
pkgrel=1
pkgdesc="Development tools for Manjaro Linux"
arch=('any')
url="https://code.manjaro.org/tools/manjaro-tools"
license=('GPL-2.0-or-later')
groups=('manjaro-tools')
makedepends=(
  'docbook2x'
  'git'
)
_commit=dc6ba13413c6faba77c5ccdcc74121c97e9a1cab
source=("git+$url.git#commit=${_commit}")
sha256sums=('761246006872a6f6a5f54758e0264301899de8edd9d63fe804927c950fc68a3b')

pkgver() {
  cd "${pkgbase%-git}"
  git describe --long --tags --abbrev=7 | sed 's/\([^-]*-g\)/r\1/;s/-/./g'
}

prepare() {
  cd "${pkgbase%-git}"
  sed -e "s/^Version=.*/Version=$pkgver/" -i Makefile

  # patches here
}

build() {
  cd "${pkgbase%-git}"
  make PREFIX=/usr
}

package_manjaro-tools-base-git() {
  pkgdesc+=" (base tools)"
  depends=(
    'gnupg'
    'openssh'
    'os-prober'
    'pacman-mirrors'
    'rsync'
  )
  optdepends=(
    'manjaro-tools-iso-git: Manjaro Linux iso tools'
    'manjaro-tools-pkg-git: Manjaro Linux package tools'
    'manjaro-tools-yaml-git: Manjaro Linux yaml tools'
  )
  provides=("${pkgname%-git}")
  conflicts=("${pkgname%-git}")
  backup=("etc/${pkgbase%-git}/${pkgbase%-git}.conf")

  cd "${pkgbase%-git}"
  make PREFIX=/usr DESTDIR="${pkgdir}" install_base
}

package_manjaro-tools-pkg-git() {
  pkgdesc+=" (packaging tools)"
  depends=(
    'manjaro-tools-base-git'
    'namcap'
  )
  provides=("${pkgname%-git}")
  conflicts=("${pkgname%-git}" 'devtools')

  cd "${pkgbase%-git}"
  make PREFIX=/usr DESTDIR="${pkgdir}" install_pkg
}

package_manjaro-tools-yaml-git() {
  pkgdesc+=" (yaml tools)"
  depends=(
    'calamares-tools'
    'manjaro-iso-profiles-base'
    'manjaro-tools-base-git'
    'ruby-kwalify'
  )
  provides=("${pkgname%-git}")
  conflicts=("${pkgname%-git}")

  cd "${pkgbase%-git}"
  make PREFIX=/usr DESTDIR="${pkgdir}" install_yaml
}

package_manjaro-tools-iso-git() {
  pkgdesc="Development tools for Manjaro Linux (ISO tools)"
  depends=(
    'dosfstools'
    'git'
    'grub'
    'libisoburn'
    'manjaro-tools-yaml-git'
    'mkinitcpio'
    'mktorrent'
    'snapd'
    'squashfs-tools'
  )
  provides=("${pkgname%-git}")
  conflicts=("${pkgname%-git}")

  cd "${pkgbase%-git}"
  make PREFIX=/usr DESTDIR="${pkgdir}" install_iso
}
