# Maintainer:
# Contributor: Bernhard Landauer <bernhrd@manjaro.org>
# Contributor: FadeMind

pkgname=(
  'manjaro-wallpapers-18.0'
  'illyria-wallpaper'
)
pkgbase=manjaro-wallpapers-18.0
pkgver=1.4
pkgrel=5
pkgdesc="Official Wallpapers for the Manjaro Linux 18.x release"
arch=('any')
url="https://code.manjaro.org/artwork/manjaro-wallpapers-18.0"
license=('GPL-3.0-or-later')
makedepends=('git')
options=('!strip')
source=("git+https://code.manjaro.org/artwork/manjaro-wallpapers-18.0.git#tag=$pkgver")
sha256sums=('747f506562f3324d60e677675a7502703d19fd43346986ee46e8d34d1bc2024f')

package_manjaro-wallpapers-18.0() {
  depends=('illyria-wallpaper')

  cd "$pkgbase"
  make DESTDIR="$pkgdir" install

  rm -v "$pkgdir/usr/share/backgrounds/$pkgbase"/illyria-default{,-lockscreen}.jpg

  install -d "$pkgdir"/usr/share/backgrounds/xfce
  for i in $(ls "$pkgdir"/usr/share/backgrounds/$pkgbase); do
    ln -sv "/usr/share/backgrounds/$pkgbase/${i}" "$pkgdir/usr/share/backgrounds/xfce/${i}"
  done
}

package_illyria-wallpaper() {
  cd "$pkgbase"
  install -Dm644 illyria-default.jpg \
    "$pkgdir"/usr/share/backgrounds/illyria-default.jpg
  install -m644 illyria-default-lockscreen.jpg \
    "$pkgdir"/usr/share/backgrounds/illyria-default-lockscreen.jpg
}
