pkgname=mhwd
pkgver=0.6.6
pkgrel=9
pkgdesc="Manjaro Linux Hardware Detection library and application"
arch=('x86_64')
url="https://code.manjaro.org/applications/mhwd"
license=('GPL-3.0-or-later')
depends=(
  'hwinfo'
  'mesa'
  'mhwd-db>=20250929'
  'nvidia-driver-assistant'
  'pacman'
)
makedepends=(
  'cmake'
  'git'
  'patch'
)
optdepends=(
  'grub: for choosing kernels'
  'lib32-mesa: for 32bit libgl support'
)
provides=('libmhwd.so')
install="$pkgname.install"

# =============================================================================
# NVIDIA DRIVER ASSISTANT INTEGRATION MODE
# =============================================================================
# Select exactly ONE integration mode by setting NVIDIA_ASSISTANT_MODE below.
# This changes only which MHWD integration patch is applied. It does not change
# pkgver/pkgrel, the MHWD source revision, or the NVIDIA Driver Assistant itself.
# The nvidia-driver-assistant source code is not patched or modified here.
#
# Available modes:
#
#   authority
#     The NVIDIA Driver Assistant makes the NVIDIA driver-branch decision for
#     the system. MHWD uses the result of `nvidia-driver-assistant --mhwd-config`
#     and searches its available profiles for the matching branch. MHWD's own
#     profile priority does not override the Assistant's result. If the Assistant
#     cannot return a valid choice, or MHWD has no matching profile, MHWD does
#     not fall back to choosing an NVIDIA profile by priority.
#
#   corrective
#     MHWD makes its normal choice first, using the existing profile priority
#     order. The NVIDIA Driver Assistant then checks the selected branch for
#     each NVIDIA PCI device using its `--mhwd-branch --mhwd-device-id` interface.
#     If MHWD's choice disagrees with the Assistant's supportedchips.html result,
#     MHWD switches to an available profile for the required branch. If no
#     suitable profile exists, that NVIDIA device is skipped rather than installing
#     a profile for the wrong branch. If the Assistant cannot determine a branch,
#     MHWD keeps its original priority-based choice.
#
# Hybrid profiles are taken into account in both modes. The two patches implement
# alternative behaviours for the same MHWD auto-configuration path, so they must
# NEVER be applied together. Change only the value below to select the behaviour.
# For the normal Assistant-controlled behaviour, leave it as "authority".
# For the MHWD-first behaviour with Assistant correction, set it to "corrective".
NVIDIA_ASSISTANT_MODE="corrective"

case "${NVIDIA_ASSISTANT_MODE}" in
  authority)
    _nvidia_assistant_patch="0001-mhwd-nvidia-assistant-integration.patch"
    ;;
  corrective)
    _nvidia_assistant_patch="0002-mhwd-nvidia-assistant-corrective.patch"
    ;;
  *)
    echo "ERROR: Invalid NVIDIA_ASSISTANT_MODE='${NVIDIA_ASSISTANT_MODE}'." >&2
    echo "Choose exactly one supported value: authority or corrective." >&2
    exit 1
    ;;
esac

_commit=6ddcc6072c28a067ecebe6d38245dd0748f59c0f
source=(
  "git+https://code.manjaro.org/applications/mhwd.git#commit=${_commit}"
  "0001-mhwd-nvidia-assistant-integration.patch"
  "0002-mhwd-nvidia-assistant-corrective.patch"
)
sha256sums=('5450b471ae6bb6a716b4a29cdc8e68014f0be585338de95d05a1bcf1a7c08a92'
            '3bac2ccbf416c2d1fc96701ba36c5a580102556a814078b1279f25a6c005f001'
            'd22a4bd82eb07df40931e684c1439fac8c852de77cec81b119bcf52bbd7dd894')

# =============================================================================
# PATCH KONFIGURÁCIÓ
# =============================================================================
# Apply the selected integration patch with the standard patch utility.
# Fuzz is disabled so the patch must match the pinned MHWD source exactly.

_patch_apply() {
    local _patchfile="$1"

    patch --batch --forward -Np1 -i "$_patchfile"
}

prepare() {
  cd "${srcdir}/${pkgname}"

  echo ">>> NVIDIA Driver Assistant integration mode: ${NVIDIA_ASSISTANT_MODE}"
  echo ">>> Applying: ${_nvidia_assistant_patch}"
  echo ">>> patch options: --batch --forward -Np1 -i"
  _patch_apply "${srcdir}/${_nvidia_assistant_patch}" \
    || { echo "!!! PATCH FAILED"; exit 1; }
  echo ">>> PATCH applied."
}

build() {
  cmake -B build -S "$pkgname" \
    -DCMAKE_BUILD_TYPE='RelWithDebInfo' \
    -DCMAKE_INSTALL_PREFIX='/usr' \
    -DCMAKE_POLICY_VERSION_MINIMUM='3.5'
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -d "$pkgdir/var/lib/$pkgname"/{db,local}/{pci,usb}
}
