pkgname=morewaita-icon-theme
pkgver=50.1
pkgrel=1
pkgdesc="An expanded Adwaita-styled companion icon theme with extra icons"
arch=('any')
url="https://github.com/somepaulo/MoreWaita"
license=('GPL-3.0-or-later')
depends=('adwaita-icon-theme')
makedepends=(
  'git'
  'meson'
)
options=('!strip')
source=("git+https://github.com/somepaulo/MoreWaita#tag=v$pkgver")
sha256sums=('c86cd92b7772ee1a6ebf2bc2adc73c54fb25b226ad5b8391b2a25fd6f49a2acd')

build() {
  arch-meson MoreWaita build
  meson compile -C build
}

package() {
  meson install -C build --no-rebuild --destdir "$pkgdir"
}
