pkgname=morewaita-icon-theme
pkgver=50
pkgrel=1
pkgdesc="An expanded Adwaita-styled companion icon theme with extra icons"
arch=('any')
url="https://github.com/somepaulo/MoreWaita"
license=('GPL-3.0-or-later')
depends=('adwaita-icon-theme')
makedepends=('git')
options=('!strip')
source=("git+https://github.com/somepaulo/MoreWaita#tag=v$pkgver")
sha256sums=('5bd97240b74bc86c401fdb01a5b9afb1ca0bd69b6a0637d31c84a6e1d5fd0d6f')

package() {
  cd MoreWaita
  install -Dm644 index.theme -t "$pkgdir/usr/share/icons/MoreWaita/"
  cp -a 16x16 scalable symbolic "$pkgdir/usr/share/icons/MoreWaita"

  find "$pkgdir/usr/share/icons/MoreWaita" -name 'meson.build' -type f | xargs rm -v
}
