# Maintainer:
# Contributor: Kewl <xrjy@nygb.rh.bet(rot13)>

pkgname=opennic-up
pkgver=1.2.4
pkgrel=3
pkgdesc="OpenNIC auto DNS updater"
arch=('any')
url="https://github.com/kewlfft/opennic-up"
license=('LGPL-3.0-or-later')
depends=(
  'fping'
  'ldns'
)
optdepends=('networkmanager')
source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz"
        "${pkgname}-on-boot.service")
sha256sums=('8cb7ae04f1af55c900a24a72da23807b0250df415be2bedc73242d86750f26c6'
            'c5eedeb0c864528a99dac0cb176c5d341104ee058582a1fcc9dc83968f5c85d9')

package() {
  cd "${pkgname}-${pkgver}"
  install -Dm755 -t "${pkgdir}/usr/bin" "${pkgname}"
  install -Dm644 -t "${pkgdir}/usr/lib/systemd/system" "${pkgname}".{service,timer}
  install -Dm644 -t "${pkgdir}/usr/lib/systemd/system" "${srcdir}/${pkgname}-on-boot.service"
}
