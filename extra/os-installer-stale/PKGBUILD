# Maintainer: Dennis ten Hoove <contact@arkanelinux.org>
pkgname=os-installer-stale
_pkgname=os-installer
pkgver=0.3.1
pkgrel=1
pkgdesc='Operating system installer by the GNOME project'
url='https://gitlab.gnome.org/p3732/os-installer'
source=("git+https://gitlab.gnome.org/p3732/$_pkgname.git#tag=$pkgver"
        'list_disk_if_zero.patch')
sha256sums=('SKIP' '726189d3b61233c9ec6d75522c99f9b14f47a56674150d2fcb7029e265df42c9')
arch=('x86_64')
license=('GPL3')
makedepends=('meson' 'appstream-glib' 'blueprint-compiler' 'git')
depends=('gnome-desktop' 'gtk4' 'libadwaita' 'libgweather-4' 'python-yaml' 'udisks2' 'vte4' 'python-gobject')
optdepends=('epiphany: online assistance'
            'gnome-disk-utility: manual disk partitioning'
            'gnome-control-center: Wi-Fi setup')
provides=(os-installer)
conflicts=(os-installer)

prepare () {
	cd $srcdir/$_pkgname
	patch -p1 < $srcdir/list_disk_if_zero.patch
}

build () {
	cd $srcdir/$_pkgname
	meson setup --prefix=/usr build
}

package() {
	cd $srcdir/$_pkgname
	meson install -C build --destdir $pkgdir
}
