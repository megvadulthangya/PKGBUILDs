# Maintainer: Philip Müller <philm@manjaro.org>
# Contributor: Guillaume Benoit <guillaume@manjaro.org>

pkgname=pamac-cli
pkgver=11.7.4+4+g00c19aa
pkgrel=1
pkgdesc="A CLI Package Manager based on libalpm with AUR support"
arch=('x86_64' 'aarch64')
url="https://github.com/manjaro/pamac-cli"
license=('GPL-3.0-or-later')
depends=(
  'libpamac>=11.7.4'
)
optdepends=(
  'plymouth: offline upgrade support'
#  'libpamac-aur-plugin: for AUR support'
)
makedepends=(
  'asciidoc'
  'git'
  'meson'
  'vala'
)
conflicts=('pamac<=7.3.4-2')
options=('debug')
_commit=00c19aa90ebc5c5902d89babe6d6ff0b79e457b4
source=("git+https://github.com/manjaro/pamac-cli.git#commit=${_commit}")
sha256sums=('1440c1e93175c98bcf02435aabe5cdc36eeee67fcca5e4b5ce30808697105b1d')

_backports=(
)

_reverts=(
)

pkgver() {
  cd "$pkgname"
  git describe --tags --abbrev=7 | sed 's/-/+/g'
}

prepare() {
  cd "$pkgname"

  local _c _l
  for _c in "${_backports[@]}"; do
    if [[ "${_c}" == *..* ]]; then _l='--reverse'; else _l='--max-count=1'; fi
    git --no-pager log --oneline "${_l}" "${_c}"
    git cherry-pick --mainline 1 --no-commit "${_c}"
  done
  for _c in "${_reverts[@]}"; do
    if [[ "${_c}" == *..* ]]; then _l='--reverse'; else _l='--max-count=1'; fi
    git --no-pager log --oneline "${_l}" "${_c}"
    git revert --mainline 1 --no-commit "${_c}"
  done
}

build() {
  arch-meson "$pkgname" build
  meson compile -C build
}

package() {
  meson install -C build --no-rebuild --destdir "$pkgdir"
}
