# Contributor: Helmut Stult

pkgbase=pamac
pkgname=(
  'pamac-gtk'
  'pamac-gnome-integration'
)
pkgver=11.7.5+23+ge8b91d5
pkgrel=1
pkgdesc="A Package Manager based on libalpm with AUR and Appstream support (GTK4)"
arch=('x86_64' 'aarch64')
url="https://github.com/manjaro/pamac"
license=('GPL-3.0-or-later')
depends=(
  'archlinux-appstream-data'
  'gdk-pixbuf2'
  'glibc'
  'glib2'
  'gtk3'
  'gtk4'
#  'jemalloc' ## causes glib error & coredump
  'libadwaita'
  'libnotify'
  'libpamac>=11.7.4'
  'pamac-cli>=11.7.4'
)
makedepends=(
  'asciidoc'
  'git'
  'gobject-introspection'
  'meson'
  'vala'
)
options=('debug')
_commit=e8b91d5d770bbb787b49d2c61e4a804f8b127946
source=("git+https://github.com/manjaro/pamac.git#commit=${_commit}")
sha256sums=('5bd1c9cb109a97229567512942cc17167e51922bc7a7de1242484eea5dc51827')

_backports=(
)

_reverts=(
)

pkgver() {
  cd "$pkgbase"
  git describe --tags --abbrev=7 | sed 's/^v//;s/-/+/g'
}

prepare() {
  cd "$pkgbase"
  local src
  for src in "${source[@]}"; do
      src="${src%%::*}"
      src="${src##*/}"
      [[ $src = *.patch ]] || continue
      echo "Applying patch $src..."
      patch -Np1 < "../$src"
  done

  local _c _l
  for _c in "${_backports[@]}"; do
    if [[ "${_c}" == *..* ]]; then _l='--reverse'; else _l='--max-count=1'; fi
    git --no-pager log --oneline "${_l}" "${_c}"
    git cherry-pick --mainline 1 --no-commit "${_c}"
  done
  for _c in "${_reverts[@]}"; do
    if [[ "${_c}" == *..* ]]; then _l='--reverse'; else _l='--max-count=1'; fi
    git --no-pager log --oneline "${_l}" "${_c}"
    git revert --mainline 1 --no-commit "${_c}"
  done
}

build() {
  local meson_options=(
    -Denable-fake-gnome-software=true
    -Djemalloc=false
  )
  arch-meson "$pkgbase" build "${meson_options[@]}"
  meson compile -C build
}

check() {
  cd "$pkgbase"
  desktop-file-validate data/applications/*.desktop || :
}

package_pamac-gtk() {
  optdepends=(
    'pamac-gnome-integration: Software Updates integration on GNOME'
    'pamac-tray-icon-plasma: Tray icon on Plasma'
    'libpamac-flatpak-plugin: Flatpak support'
    'libpamac-snap-plugin: Snap support'
#  'libpamac-aur-plugin: AUR support'
#  'libpamac-appstream-plugin: Appstream support'
    'xapp: Required for tray icon in Cinnamon Wayland sessions'
  )
  provides=(
    'pamac'
    'libpamac-gtk.so'
  )
  conflicts=(
    'pamac-gtk3'
  )
  install="$pkgname.install"

  meson install -C build --no-rebuild --destdir "$pkgdir"

  # remove pamac-gnome-integration
  rm -v "$pkgdir/usr/bin/gnome-software"
  rm -v "$pkgdir/usr/share/applications/org.gnome.Software.desktop"
  rm -v "$pkgdir/usr/share/dbus-1/services/org.gnome.Software.service"
}

package_pamac-gnome-integration() {
  pkgdesc="Pamac GNOME integration"
  depends=('pamac-gtk')
  conflicts=('gnome-software')

  install -Dvm644 "build/data/dbus/org.gnome.Software.service" \
    "$pkgdir/usr/share/dbus-1/services/org.gnome.Software.service"
  install -Dvm755 "build/src/gnome-software" "$pkgdir/usr/bin/gnome-software"
  install -Dvm644 "$pkgbase/data/applications/org.gnome.Software.desktop" \
    "$pkgdir/usr/share/applications/org.gnome.Software.desktop"
}
