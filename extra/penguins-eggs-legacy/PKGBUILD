# Contributor: Mark Wagie <mark at manjaro dot org>
# Contributor: Piero Proietti <piero.proietti_at_gmail.com>

_bootloadersver=26.1.16

pkgname=penguins-eggs-legacy
pkgver=26.7.18
pkgrel=1
pkgdesc="A console tool that allows you to remaster your system and redistribute it as live images on USB sticks or via PXE"
arch=('any')
url="https://penguins-eggs.net"
license=('GPL-2.0-or-later')

depends=(
 'arch-install-scripts'
 'cryptsetup'
 'dosfstools'
 'efibootmgr'
 'erofs-utils'
 'grub'
 'jq'
 'libarchive'
 'libisoburn'
 'lvm2'
 'manjaro-tools-iso'
 'mkinitcpio-nfs-utils'
 'mtools'
 'nbd'
 'nodejs'
 'pacman-contrib'
 'parted'
 'polkit'
 'pv'
 'python'
 'rsync'
 'squashfs-tools'
 'sshfs'
 'xdg-utils'
)

optdepends=(
 'bash-completion: eggs autocomplete'
 'calamares: system installer GUI'
 'zsh-completions: eggs autocomplete'
)

makedepends=(
 'pnpm'
 'git'
)

conflicts=('oa-tools')
options=('!strip')

source=("git+https://github.com/pieroproietti/penguins-eggs-legacy.git#tag=v$pkgver"
        "bootloaders.tar.gz::https://github.com/pieroproietti/penguins-bootloaders/releases/download/v$_bootloadersver/bootloaders.tar.gz")

sha256sums=('95319b7e31274d360a6f0f57aded0f00701bdbd8dd274099596b42aceb0c865c'
            'ec50a56a513e40c4b1f731452d08b9cd82ddd8c70a4d94ef502c80a1fa4ea504')

build() {
  cd "$srcdir/$pkgname"
  env NODE_ENV=development pnpm install
  pnpm build  
  rm -rf node_modules
  pnpm install --prod --offline
}

package() {
  cd "$srcdir/$pkgname"

  install -Dm644 .oclif.manifest.json package.json -t "$pkgdir/usr/lib/$pkgname"
  cp -r addons \
      assets \
      bin \
      conf \
      dist \
      eui \
      mkinitcpio \
      node_modules \
      scripts \
      "$pkgdir/usr/lib/$pkgname/"

  cp -r "$srcdir/bootloaders" "$pkgdir/usr/lib/$pkgname/"

  # Fix permissions
  chown -R root:root "$pkgdir/usr/lib/$pkgname/"

  # Install documentation
  install -Dm644 README.md -t "$pkgdir/usr/share/doc/$pkgname/"

  # Install bash-completion files
  install -d "$pkgdir/usr/share/bash-completion/completions"
  ln -s "/usr/lib/$pkgname/scripts/eggs-legacy.bash" \
        "$pkgdir/usr/share/bash-completion/completions/eggs-legacy"

  # Install zsh-completion files
  install -d "$pkgdir/usr/share/zsh/functions/Completion/Zsh/"
  ln -s "/usr/lib/$pkgname/scripts/_eggs-legacy" \
        "$pkgdir/usr/share/zsh/functions/Completion/Zsh/_eggs-legacy"

  # Install man page
  install -Dm644 manpages/doc/man/eggs-legacy.1.gz -t "$pkgdir/usr/share/man/man1/"

  # Install desktop file
  install -Dm644 assets/"$pkgname".desktop -t "$pkgdir/usr/share/applications/"

  # Install icon
  install -Dm644 assets/eggs.png -t "$pkgdir/usr/share/pixmaps/"

  # Revitalize mom
  chmod +x "$pkgdir/usr/lib/$pkgname/scripts/mom.sh"

  # Revitalize eui
  chmod +x "$pkgdir/usr/lib/$pkgname/eui/eui-create-image.sh"
  chmod +x "$pkgdir/usr/lib/$pkgname/eui/eui-start.sh"
  chmod 0400 "$pkgdir/usr/lib/$pkgname/eui/eui-users"

  # Symlink executable
  install -d "$pkgdir/usr/bin"
  ln -s "/usr/lib/$pkgname/bin/run.js" "$pkgdir/usr/bin/eggs-legacy"

  # Symlink to adapt
  ln -s "/usr/lib/$pkgname/addons/eggs/adapt/bin/adapt" "$pkgdir/usr/bin/adapt"
}
