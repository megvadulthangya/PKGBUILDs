# Maintainer: Philip Mueller <philm@manjaro.org>

pkgname=plasma-setup
pkgver=6.8.1
pkgrel=1
pkgdesc='KDE Plasma first run setup tool'
arch=('x86_64')
url="https://kde.org/plasma-desktop"
license=(
  'BSD-2-Clause'
  'CC0-1.0'
  'GPL-2.0-only OR GPL-3.0-only'
  'LGPL-2.1-only OR LGPL-3.0-only'
  'GPL-2.0-or-later OR GPL-3.0-or-later'
  'LGPL-2.0-or-later OR LGPL-3.0-or-later'
  'LGPL-2.1-or-later OR LGPL-3.0-or-later'
)
depends=(
  'kauth'
  'kconfig'
  'kcoreaddons'
  'ki18n'
  'kitemmodels'
  'kpackage'
  'libkscreen'
  'plasma-desktop'
  'plasma-keyboard'
  'plasma-workspace'
  'qt6-base'
  'qt6-declarative'
)
makedepends=(
  'cmake'
  'extra-cmake-modules'
  'git'
)
source=("git+https://invent.kde.org/plasma/plasma-setup.git#tag=v$pkgver"
        '0000-kill-plymouth.patch')
sha256sums=('b1a583447847565380faaea1db3ee28a61e091836d2d82496e67de902e032a1a'
            'a9fe89958f319f8930254d3d7d85f9c95fae22d980c7595c8951d87941ead022')

_backports=(
)

_reverts=(
)

prepare() {

  # return if not a git repository
  if ! git status >/dev/null 2>&1; then
    return
  fi

  local _c _l
  for _c in "${_backports[@]}"; do
    if [[ "${_c}" == *..* ]]; then _l='--reverse'; else _l='--max-count=1'; fi
    git --no-pager log --oneline "${_l}" "${_c}"
    git cherry-pick --mainline 1 --no-commit "${_c}"
  done
  for _c in "${_reverts[@]}"; do
    if [[ "${_c}" == *..* ]]; then _l='--reverse'; else _l='--max-count=1'; fi
    git --no-pager log --oneline "${_l}" "${_c}"
    git revert --mainline 1 --no-commit "${_c}"
  done

  cd "$pkgname"
  patch -Np1 -i ../0000-kill-plymouth.patch
}

build() {
  cmake -B build -S "$pkgname" \
    -DCMAKE_BUILD_TYPE='RelWithDebInfo' \
    -DCMAKE_INSTALL_PREFIX='/usr' \
    -DCMAKE_INSTALL_LIBEXECDIR='lib' \
    -DBUILD_TESTING='OFF' \
    -Wno-author
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build

  cd "$pkgname"
  install -Dm644 LICENSES/BSD-2-Clause.txt -t "$pkgdir/usr/share/licenses/"
}
