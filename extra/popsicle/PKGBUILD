# Maintainer: Mark Wagie <mark at manjaro dot org>

pkgname=popsicle
pkgver=1.12.0
pkgrel=0
pkgdesc="Linux utility for flashing multiple USB devices in parallel, written in Rust"
arch=('x86_64' 'aarch64')
url="https://github.com/pop-os/popsicle"
license=('MIT')
depends=(
  'libgcc'
  'libxkbcommon'
  'udisks2'
)
makedepends=(
  'git'
  'help2man'
  'just'
  'rust'
)
checkdepends=(
  'appstream'
  'desktop-file-utils'
)
source=("git+https://github.com/pop-os/popsicle.git#tag=$pkgver")
sha256sums=('5eed02b7ba530efbee5d4c754ee9b75bc0d899c489bb3bf256866e16c5ffc683')

prepare() {
  cd "$pkgname"
  cargo fetch --locked --target host-tuple
}

build() {
  cd "$pkgname"
  just build-release --frozen
}

check() {
  cd "$pkgname"
  appstreamcli validate --no-net resources/app.metainfo.xml
  desktop-file-validate resources/app.desktop
}

package() {
  cd "$pkgname"
  just prefix='/usr' rootdir="$pkgdir" install

  install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"
}
