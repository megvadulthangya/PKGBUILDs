# Maintainer: Mark Wagie <mark at manjaro dot org>

pkgname=refine
pkgver=0.9.0
pkgrel=0.1
pkgdesc="Tweak various aspects of GNOME"
arch=('any')
url="https://tesk.page/refine"
license=('GPL-3.0-or-later')
depends=(
  'dconf'
  'glib2'
  'gtk4'
  'hicolor-icon-theme'
  'libadwaita'
  'libportal'
  'libportal-gtk4'
  'pango'
  'python'
  'python-gobject'
)
makedepends=(
  'blueprint-compiler'
  'git'
  'meson'
)
checkdepends=(
  'appstream'
  'desktop-file-utils'
)
source=("git+https://gitlab.gnome.org/TheEvilSkeleton/Refine.git#tag=$pkgver"
        'experimental-features.patch')
sha256sums=('83924a98e96bdecba6740811d49b4cce2cc6f2416dcdb767a02f225defc700ec'
            '4be6f85528b288c01fde009b408e690bc3cd34858342b1591074e5f8f4d45e8c')

prepare() {
  cd Refine

  # Remove / update experimental features no longer available in GNOME 50+
  patch -Np1 -i ../experimental-features.patch
}

build() {
  arch-meson Refine build
  meson compile -C build
}

check() {
  meson test -C build --no-rebuild --print-errorlogs
}

package() {
  meson install -C build --no-rebuild --destdir "$pkgdir"
}
