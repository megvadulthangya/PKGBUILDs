# Maintainer: Mark Wagie <mark at manjaro dot org>

pkgname=shiny-mirrors
pkgver=1.0.0
pkgrel=1
pkgdesc="An alternative to pacman-mirrors, rewritten in Rust! A tool to find the best mirrors for you!"
arch=('x86_64' 'aarch64')
url="https://gitlab.com/Arisa_Snowbell/shiny-mirrors"
license=('GPL-3.0-only')
depends=(
  'glibc'
  'libgcc'
)
makedepends=(
  'git'
  'rust'
)
backup=("etc/$pkgname.toml")
install="$pkgname.install"
source=("git+https://gitlab.com/Arisa_Snowbell/shiny-mirrors.git#tag=v${pkgver}?signed")
sha256sums=('1f504ac20fce9f55b67c7a59bda5f48f3673d407d19d34a6339a7e57e3260acd')
validpgpkeys=('E2C998FA1F7B651E45B20CDC56AA2C2801F619D7') # Arisa Snowbell (Hyena) <arisa.snowbell@gmail.com>

prepare() {
  cd "$pkgname"
  cargo fetch --locked --target host-tuple
}

build() {
  cd "$pkgname"
  CFLAGS+=" -ffat-lto-objects"
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release --no-default-features --features manjaro
}

package() {
  cd "$pkgname"
  install -Dm755 "target/release/$pkgname" -t "$pkgdir/usr/bin/"
  install -Dm644 "target/gen/_${pkgname}" -t \
    "$pkgdir/usr/share/zsh/site-functions/"
  install -Dm644 "target/gen/$pkgname.bash" \
    "$pkgdir/usr/share/bash-completion/completions/$pkgname"
  install -Dm644 "target/gen/$pkgname.fish" -t \
    "$pkgdir/usr/share/fish/vendor_completions.d/"
  install -Dm644 "$pkgname/man/$pkgname.1" -t "$pkgdir/usr/share/man/man1/"
  install -Dm644 "conf/$pkgname.toml" -t "$pkgdir/etc/"
  install -Dm644 "$pkgname/systemd/$pkgname"{.service,.timer} -t \
    "$pkgdir/usr/lib/systemd/system/"
}
