# Maintainer: Mark Wagie <mark at manjaro dot org>
# Contributor: Bernhard Landauer <bernhard@manjaro.org>

# Slimbook OBS
# https://build.opensuse.org/package/show/home:Slimbook/slimbook-service

pkgname=slimbook_service
pkgver=1.0.16
pkgrel=1
pkgdesc="Service for Slimbook laptops"
arch=('any')
url="https://github.com/Slimbook-Team/slimbook_service"
license=('GPL-3.0-or-later')
depends=(
  'gtk4'
  'libadwaita'
  'libnotify'
  'libslimbook'
  'power-profiles-daemon'
  'python-dateutil'
  'python-dbus'
  'python-evdev'
  'python-feedparser'
  'python-gobject'
  'python-pyudev'
  'python-pyzmq'
  'python-requests'
  'python-slimbook'
)
optdepends=('slimbook-qc71-dkms')
provides=('slimbook-service')
install="$pkgname.install"
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/$pkgver.tar.gz")
sha256sums=('27f7013d664ba782185a04460384809bba23dd953ade2a96fe813579bbbb7911')

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 slimbook/bin/slimbookindicator -t "$pkgdir/usr/bin/"

  install -Dm644 90-slimbook-service.preset -t "$pkgdir/usr/lib/systemd/system-preset/"
  install -Dm644 slimbook-service.service -t "$pkgdir/usr/lib/systemd/system/"

  install -Dm644 slimbook/usr/share/slimbook/*.py -t "$pkgdir/usr/share/slimbook/"
  cp -r slimbook/usr/share/icons "$pkgdir/usr/share/slimbook"
  cp -r slimbook/usr/share/icons "$pkgdir/usr/share/"

  install -d "$pkgdir/usr/share/applications"
  install -d "$pkgdir/etc/xdg/autostart"
  install -Dm644 slimbook/usr/share/slimbook/slimbook-indicator.desktop -t \
    "$pkgdir/usr/share/slimbook/"
  ln -s /usr/share/slimbook/slimbook-indicator.desktop "$pkgdir/usr/share/applications/"
  install -Dm644 slimbook/usr/share/slimbook/slimbook-client-autostart.desktop -t \
    "$pkgdir/usr/share/slimbook"
  ln -s /usr/share/slimbook/slimbook-client-autostart.desktop "$pkgdir/etc/xdg/autostart/"

  local langdir="usr/share/slimbook/locale-langpack"
  for lang in ast ca es ru; do
    install -d "$pkgdir/${langdir}/${lang}/LC_MESSAGES"
    msgfmt "slimbook/${langdir}/${lang}/LC_MESSAGES/slimbook.po" -o \
      "$pkgdir/${langdir}/${lang}/LC_MESSAGES/slimbook.mo"
  done
}
