post_install() {
  echo "Enabling and starting slimbook-service..."
  systemctl enable --now slimbook-service
}

post_upgrade() {
  echo "Restarting slimbook-service..."
  systemctl restart slimbook-service
}

pre_remove() {
  echo "Disabling and stopping slimbook-service..."
  systemctl disable --now slimbook-service
}
