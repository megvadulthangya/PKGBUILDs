# Maintainer: Mark Wagie <mark at manjaro dot org>

pkgname=slimbookamdcontroller
pkgver=0.4.6.0
pkgrel=1
pkgdesc="Application for the performance management of AMD processors"
arch=('any')
url="https://github.com/Slimbook-Team/slimbookamdcontroller"
license=('GPL-3.0-or-later')
depends=(
  'gtk3'
  'libayatana-appindicator'
  'libnotify'
  'polkit'
  'python-cairo'
  'python-gobject'
  'python-matplotlib'
  'python-pyamdgpuinfo'
  'ryzenadj'
  'systemd-libs'
)
#source=("$url/releases/download/v$pkgver/${pkgname}_${pkgver}_all.deb")
source=("https://launchpad.net/~slimbook/+archive/ubuntu/slimbook/+files/${pkgname}_${pkgver}~bpo22.04.0_amd64.deb")
sha256sums=('6390bc8e8de8137d2e2343df75a3d3b901ee3e67fd2a87e2070a8c255042f6ad')

package() {
  bsdtar xf data.tar.zst -C "$pkgdir"

  install -d "$pkgdir/usr/lib/udev/rules.d"
  mv "$pkgdir/etc/udev/rules.d/81.power.rules" "$pkgdir/usr/lib/udev/rules.d/"
  rm -rf "$pkgdir/etc/"

  # App permissions
  chmod +x "$pkgdir/usr/lib/systemd/system-sleep/$pkgname"
  chmod -R 755 "$pkgdir/usr/share/$pkgname/src/"
}
