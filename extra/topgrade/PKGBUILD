# Maintainer: Mark Wagie <mark at manjaro dot org>

pkgname=topgrade
pkgver=17.13.0
pkgrel=2
pkgdesc="Upgrade all the things"
arch=('x86_64' 'aarch64')
url="https://topgrade-rs.github.io"
license=('GPL-3.0-or-later')
depends=('libgcc')
makedepends=('rust')
source=("$pkgname-$pkgver.tar.gz::https://github.com/topgrade-rs/topgrade/archive/refs/tags/v$pkgver.tar.gz"
        'https://github.com/topgrade-rs/topgrade/pull/2425.patch')
sha256sums=('ec055df2751471229f9891d012686703afca2e525b3bff49fa2ae8a77bfe23c9'
            'c1247843cfecda0b4abcd1185aa5991cf679a65891baae4df56a22992f71f899')

prepare() {
  cd "$pkgname-$pkgver"

  # Update dependencies
  patch -Np1 -i ../2425.patch

  cargo fetch --locked --target host-tuple
}

build() {
  cd "$pkgname-$pkgver"
  CFLAGS+=" -ffat-lto-objects"
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release

  # Generate completions
  for shell in bash fish zsh; do
    ./"target/release/$pkgname" --gen-completion "${shell}" > "$pkgname.${shell}"
  done

  # Generate man page
  ./"target/release/$pkgname" --gen-manpage > "$pkgname.1"
}

check() {
  cd "$pkgname-$pkgver"
  cargo test --frozen
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 "target/release/$pkgname" -t "$pkgdir/usr/bin/"
  install -Dm644 "$pkgname.1" -t "$pkgdir/usr/share/man/man1/"
  install -Dm644 "$pkgname.bash" "$pkgdir/usr/share/bash-completion/completions/$pkgname"
  install -Dm644 "$pkgname.fish" -t "$pkgdir/usr/share/fish/vendor_completions.d/"
  install -Dm644 "$pkgname.zsh" "$pkgdir/usr/share/zsh/site-functions/_${pkgname}"
  install -Dm644 config.example.toml -t "$pkgdir/usr/share/doc/$pkgname/"
}
