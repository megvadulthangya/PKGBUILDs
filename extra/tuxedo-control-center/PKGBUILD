# Maintainer: Mark Wagie <mark at manjaro dot org>

pkgname=tuxedo-control-center
_app_id=com.tuxedocomputers.tcc
pkgver=3.1.1
pkgrel=1
_nodeversion=24
pkgdesc="A tool to help you control performance, energy, fan and comfort settings on TUXEDO laptops."
arch=('x86_64')
url="https://github.com/tuxedocomputers/tuxedo-control-center"
license=('GPL-3.0-or-later')
depends=(
  'alsa-lib'
  'gtk3'
  'libxss'
  'nss'
  'polkit'
  'python'
  'systemd'
  'tuxedo-drivers-dkms'
  'upower'
)
makedepends=(
  'desktop-file-utils'
  'git'
  'libxcrypt-compat'
  'nvm'
)
checkdepends=('appstream')
optdepends=('libayatana-appindicator: tray icon')
options=('!strip')
install="${pkgname}.install"
source=("${pkgname}-${pkgver}.tar.gz::$url/archive/refs/tags/v${pkgver}.tar.gz"
        "${_app_id}.desktop")
sha256sums=('96a0d38b660d6a02677f6ce3f2078a0c7169a5b5e83ec2e772e94472815fe4d7'
            'faf33f0f2f8cb9e62e6ef8afe292ba615964d1941d07d9a08cd770507f40162a')

_ensure_local_nvm() {
  # let's be sure we are starting clean
  which nvm >/dev/null 2>&1 && nvm deactivate && nvm unload
  export NVM_DIR="$srcdir/.nvm"

  # The init script returns 3 if version specified
  # in ./.nvrc is not (yet) installed in $NVM_DIR
  # but nvm itself still gets loaded ok
  source /usr/share/nvm/init-nvm.sh || [[ $? != 1 ]]
}

prepare() {
  _ensure_local_nvm
  nvm install "${_nodeversion}"

  cd "${pkgname}-${pkgver}"
  export npm_config_cache="${srcdir}/npm_cache"
  npm install

  # error: value item "TrayIcon" in key "Categories" in group "Desktop Entry"
  # is a reserved category, so a "OnlyShowIn" key must be included
  desktop-file-edit --set-key=Categories --set-value="System;" \
    "src/dist-data/${pkgname}-tray.desktop"
}

build() {
  cd "${pkgname}-${pkgver}"
  export npm_config_cache="${srcdir}/npm_cache"
  _ensure_local_nvm

  # Disable Angular analytics prompt
  export NG_CLI_ANALYTICS=false

  npm run pack-prod deb
}

check() {
  cd "${pkgname}-${pkgver}"
  export npm_config_cache="${srcdir}/npm_cache"
  _ensure_local_nvm
  npm run tests

  desktop-file-validate "src/dist-data/${pkgname}-tray.desktop"
}

package() {
  cd "${pkgname}-${pkgver}"
  install -d "${pkgdir}"/{opt/"${pkgname}",usr/bin}
  cp -av dist/packages/linux-unpacked/* "${pkgdir}/opt/${pkgname}/"
  ln -sv "/opt/${pkgname}/${pkgname}" "${pkgdir}/usr/bin/"

  install -Dm644 "${srcdir}/${_app_id}.desktop" -t \
    "${pkgdir}/usr/share/applications/"

  install -Dm644 "src/dist-data/${pkgname}-tray.desktop" -t \
    "${pkgdir}/etc/xdg/autostart/"

  install -Dm644 "src/dist-data/${_app_id}d-service.policy" -t \
    "${pkgdir}/usr/share/polkit-1/actions/"
  install -Dm644 src/dist-data/com.tuxedocomputers.tomte-access.policy -t \
    "${pkgdir}/usr/share/polkit-1/actions/"

  install -Dm644 "src/dist-data/${_app_id}d-dbus.conf" -t \
    "${pkgdir}/usr/share/dbus-1/system.d/"

  install -Dm644 src/dist-data/tccd.service -t "${pkgdir}/usr/lib/systemd/system/"
  install -Dm644 src/dist-data/tccd-sleep.service -t "${pkgdir}/usr/lib/systemd/system/"

  install -Dm644 src/dist-data/99-webcam.rules -t "$pkgdir/usr/lib/udev/rules.d/"

  install -Dm644 "src/dist-data/${_app_id}-gui.metainfo.xml" -t \
    "${pkgdir}/usr/share/metainfo/"

  install -Dm644 "src/dist-data/${pkgname}_256.svg" \
    "${pkgdir}/usr/share/icons/hicolor/scalable/apps/${pkgname}.svg"
}
