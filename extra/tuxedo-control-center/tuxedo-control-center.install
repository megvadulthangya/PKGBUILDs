post_install() {
  echo "Enabling and starting TCC services..."
  systemctl enable --now tccd tccd-sleep
}

post_upgrade() {
  echo "Restarting TCC services..."
  systemctl restart tccd tccd-sleep
}

pre_remove() {
  echo "Disabling and stopping TTCC services..."
  systemctl disable --now tccd tccd-sleep
}
