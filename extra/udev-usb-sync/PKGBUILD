# Maintainer:
# Contributor: Frede H

pkgname=udev-usb-sync
pkgver=1.1
pkgrel=4
pkgdesc="Fine tune write cache and impose buffer limits when USB storage device is plugged"
arch=('any')
url="https://code.manjaro.org/applications/udev-usb-sync"
license=('MIT')
depends=(
  'bc'
  'hdparm'
  'udev'
)
makedepends=('git')
conflicts=('usb-dirty-pages-udev')
backup=("etc/$pkgname/$pkgname.conf")
source=("git+https://code.manjaro.org/applications/udev-usb-sync.git#tag=$pkgver")
sha256sums=('306b5326d33db9a74a7e3467812e4168f1cc29ade37b5fb6a080f4fdf5e86f23')

package() {
  cd "$pkgname"
  install -Dm644 99-usb-sync.rules -t "$pkgdir/usr/lib/udev/rules.d/"
  install -Dm644 "$pkgname.conf" -t "$pkgdir/etc/$pkgname/"
  install -Dm755 "$pkgname" -t "$pkgdir/usr/bin"
  install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"
}
