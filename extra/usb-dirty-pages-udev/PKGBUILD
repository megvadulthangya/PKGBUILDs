# Contributor: Bruno Goncalves <bigbruno@gmail.com>

pkgname=usb-dirty-pages-udev
pkgver=26.11.24
pkgrel=1
_rel=2208
pkgdesc="Use udev to specify dirty pages for usb devices"
arch=('any')
url="https://github.com/biglinux/usb-dirty-pages-udev"
license=('GPL-3.0-or-later')
conflicts=('udev-usb-sync')
replaces=('udev-usb-sync')
source=("${pkgname}-${pkgver}-${_rel}.tar.gz::${url}/archive/refs/tags/${pkgver}-${_rel}.tar.gz")
sha256sums=('eaf0490bd1b985786d5a9ba1689a410f6c6271ccb0b0ac0d9f6c23ef98dc267e')

package() {
  cd "${pkgname}-${pkgver}-${_rel}"
  install -Dm755 "usr/bin/${pkgname}" -t "$pkgdir/usr/bin/"
  install -Dm644 "etc/udev/rules.d/60-${pkgname}.rules" -t "$pkgdir/usr/lib/udev/rules.d/"
}
