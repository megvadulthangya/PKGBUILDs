# Maintainer: Mark Wagie <mark at manjaro dot org>

pkgname=velocitty
pkgver=1.0.9
pkgrel=1
pkgdesc="Terminal for Linux desktops"
arch=('any')
url="https://github.com/xapp-project/velocitty"
license=('GPL-3.0-or-later')
groups=('x-apps')
depends=(
  'gtk4'
  'libadwaita'
  'python-gobject'
  'python-setproctitle'
  'python-xapp'
  'vte4'
  'xapp-symbolic-icons'
)
makedepends=('meson')
checkdepends=('desktop-file-utils')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/$pkgver.tar.gz")
sha256sums=('34945b9401e836085036c83091253767abca3d45f0f8d0df2941eb419a1087f4')

build() {
  arch-meson "$pkgname-$pkgver" build
  meson compile -C build
}

check() {
  desktop-file-validate "build/data/org.x.$pkgname.desktop"
}

package() {
  meson install -C build --no-rebuild --destdir "$pkgdir"
}
