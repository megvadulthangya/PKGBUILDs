# Maintainer: Mark Wagie <mark at manjaro dot org>

pkgname=xfce4-xapp-status-plugin
pkgver=0.4.7
pkgrel=1
pkgdesc="XappStatus panel applet for Xfce4"
arch=('x86_64')
url="https://github.com/linuxmint/xfce4-xapp-status-plugin"
license=('GPL-3.0-or-later')
depends=(
  'gtk3'
  'json-glib'
  'xapp'
  'xfce4-panel'
)
makedepends=('meson')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/$pkgver.tar.gz")
sha256sums=('9a0c1aa912197131afe74297c80ddb000b9b8d1a642a9247428892ccfc04d9ff')

prepare() {
  cd "$pkgname-$pkgver"

  # panel-applets icon only available in mint-y-icons
  # Use matching cs-applets icon available in papirus-icon-theme
  sed -i 's/Icon=panel-applets/Icon=cs-applets/g' plugin/xapp-status-plugin.desktop.in
}

build() {
  arch-meson "$pkgname-$pkgver" build -Ddeprecated_warnings=true
  meson compile -C build
}

package() {
  meson install -C build --no-rebuild --destdir "$pkgdir"
}
