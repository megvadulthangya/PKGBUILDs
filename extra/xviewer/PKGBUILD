# Contributor: Nate Simon <njsimon10@gmail.com>

pkgname=xviewer
pkgver=3.4.18
pkgrel=1.0
pkgdesc="Simple image viewer"
arch=('x86_64')
url="https://github.com/linuxmint/xviewer"
license=('GPL-2.0-or-later')
groups=('x-apps')
depends=(
  'at-spi2-core'
  'cairo'
  'cinnamon-desktop'
  'dconf'
  'exempi'
  'gdk-pixbuf2'
  'glib2'
  'glibc'
  'gsettings-desktop-schemas'
  'gtk3'
  'hicolor-icon-theme'
  'lcms2'
  'libexif'
  'libjpeg-turbo'
  'libpeas'
  'librsvg'
  'libx11'
  'shared-mime-info'
  'xapp'
  'zlib'
)
makedepends=(
  'git'
  'glib2-devel'
  'gobject-introspection'
  'gtk-doc'
  'itstool'
  'meson'
)
checkdepends=(
  'appstream'
  'desktop-file-utils'
)
optdepends=(
  'libavif: AVIF support'
  'libheif: HEIF support'
  'webp-pixbuf-loader: webp support'
  'xviewer-plugins: Extra plugins'
  'yelp: for viewing the help manual'
)
source=("git+https://github.com/linuxmint/xviewer.git#tag=$pkgver")
sha256sums=('05d20dead35727c37ac222d1318868df7300c401a5f20b5a4d9b3ffedbe850d9')

build() {
  arch-meson "$pkgname" build
  meson compile -C build
}

check() {
  desktop-file-validate "build/data/${pkgname}.desktop"
  appstreamcli validate --no-net "build/data/${pkgname}.appdata.xml" || :
}

package(){
  meson install -C build --no-rebuild --destdir "$pkgdir"

  cd "$pkgname"
  install -Dm644 "debian/$pkgname.1" -t "$pkgdir/usr/share/man/man1/"
}
