pkgname=zfs-dkms-7.3-compat
_pkgname=zfs-dkms
pkgver=2.4.4
pkgrel=1
pkgdesc="Kernel modules for the Zettabyte File System."
arch=('x86_64')
url="https://zfsonlinux.org/"
license=('CDDL-1.0')
depends=("zfs-utils=${pkgver}" 'dkms')
provides=("ZFS-MODULE=${pkgver}" 'zfs-dkms')
# ambiguous, provided for backwards compat, pls don't use
provides+=('zfs')
conflicts=('zfs-dkms')
source=("https://github.com/zfsonlinux/zfs/releases/download/zfs-${pkgver/_/-}/zfs-${pkgver/_/-}.tar.gz"{,.asc}
        '0001-only-build-the-module-in-dkms.conf.patch'
        'kernel-7.3-compat.patch')
