From 3d236a284a8da28d0e6ab5b92c2401ec75521491 Mon Sep 17 00:00:00 2001
From: TheAlmightyOgreLord <beardedtechwizard@protonmail.com>
Date: Thu, 3 Sep 2026 09:31:22 -0700
Subject: [PATCH 2/7] compat: rename bi_bvec_done to bi_offset for 7.3

Signed-off-by: TheAlmightyOgreLord <beardedtechwizard@protonmail.com>
---
 include/os/linux/kernel/linux/blkdev_compat.h | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/include/os/linux/kernel/linux/blkdev_compat.h b/include/os/linux/kernel/linux/blkdev_compat.h
index 214f3ea0e787..ed1bf504249c 100644
--- a/include/os/linux/kernel/linux/blkdev_compat.h
+++ b/include/os/linux/kernel/linux/blkdev_compat.h
@@ -37,6 +37,7 @@
