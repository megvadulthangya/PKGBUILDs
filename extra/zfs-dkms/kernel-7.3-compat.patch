 			voc->voc_vdev = cvd;
 			voc->voc_cred = cred;
+#ifdef _KERNEL
+			voc->voc_fs.users = 1;
+			voc->voc_fs.in_exec = 0;
+			seqlock_init(&voc->voc_fs.seq);
