 #include <linux/bio.h>
 #include <linux/blk-mq.h>
+#include <linux/version.h>
 
 /*
  * 6.11 API
@@ -104,7 +105,11 @@ blk_queue_set_read_ahead(struct request_queue *q, unsigned long ra_pages)
